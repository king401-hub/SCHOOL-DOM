<?xml version="1.0" encoding="utf-8"?>
<!-- Native launch screen - shown instantly at process start, before the
     Flutter engine is even ready to draw. Kept to a static logo (Android's
     window background can't animate) - the animated SchoolDom intro lives
     in Flutter's own SplashScreen widget, shown right after this. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/launch_background" />
    <item>
        <bitmap
            android:gravity="center"
            android:src="@mipmap/ic_launcher" />
    </item>
</layer-list>
